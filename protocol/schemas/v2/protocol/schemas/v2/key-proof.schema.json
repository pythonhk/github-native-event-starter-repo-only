{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pythonhk.org/event/protocol/v2/key-proof.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registration_id", "registration", "consent"],
  "properties": {
    "schema": {"const": "pythonhk.key-proof/v2"},
    "registration_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "registration": {"type": "object", "minProperties": 1, "maxProperties": 32},
    "consent": {"type": "object", "minProperties": 1, "maxProperties": 32}
  }
}
