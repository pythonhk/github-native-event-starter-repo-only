{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pythonhk.org/event/protocol/v2/team-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "repository_id", "registration_id", "team_id", "proposer_github_id", "members", "eventctl_proposal", "issued_at", "expires_at"],
  "properties": {
    "schema": {"const": "pythonhk.team-proposal/v2"},
    "event_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "repository_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
    "registration_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "team_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "proposer_github_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["github_id", "key_id", "public_key", "role"],
        "properties": {
          "github_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
          "key_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "public_key": {"type": "string", "minLength": 1, "maxLength": 256},
          "role": {"enum": ["captain", "member"]}
        }
      }
    },
    "eventctl_proposal": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
