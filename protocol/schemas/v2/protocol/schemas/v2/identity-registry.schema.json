{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pythonhk.org/event/protocol/v2/identity-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "identities"],
  "properties": {
    "schema": {"const": "pythonhk.eventctl/identity-registry/v1"},
    "identities": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_id", "key_epoch", "identity"],
        "properties": {
          "actor_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
          "key_epoch": {"type": "string", "pattern": "^[1-9][0-9]{0,9}$"},
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["algorithm", "key_id", "public_key"],
            "properties": {
              "algorithm": {"const": "Ed25519"},
              "key_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "public_key": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
