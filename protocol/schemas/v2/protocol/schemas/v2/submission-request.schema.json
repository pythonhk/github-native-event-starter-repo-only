{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pythonhk.org/event/protocol/v2/submission-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "repository_id", "team_id", "attempt_id", "github_id", "pr_number", "pr_id", "fork_repository_id", "head_owner", "head_branch", "head_sha", "bundle_sha256", "eventctl_request", "issued_at", "expires_at"],
  "properties": {
    "schema": {"const": "pythonhk.submission-request/v2"},
    "event_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "repository_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
    "team_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "github_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
    "pr_number": {"type": "integer", "minimum": 1},
    "pr_id": {"type": "string", "pattern": "^[1-9][0-9]{0,31}$"},
    "fork_repository_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
    "head_owner": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"},
    "head_branch": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "eventctl_request": {"type": "object", "minProperties": 1, "maxProperties": 48},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
