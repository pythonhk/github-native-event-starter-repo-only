{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pythonhk.org/event/protocol/v2/team-signatures.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registration_id", "proposal_sha256", "algorithm", "signatures"],
  "properties": {
    "schema": {"const": "pythonhk.team-signatures/v2"},
    "registration_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "algorithm": {"const": "Ed25519-multisignature-v1"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["github_id", "key_id", "consent"],
        "properties": {
          "github_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
          "key_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "consent": {"type": "object", "minProperties": 1, "maxProperties": 32}
        }
      }
    }
  }
}
