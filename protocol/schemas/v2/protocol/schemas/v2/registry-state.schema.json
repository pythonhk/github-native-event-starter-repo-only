{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pythonhk.org/event/protocol/v2/registry-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "phase", "enabled", "disabled_reason", "revision", "users", "teams", "memberships", "attempts", "quotas", "results", "scoring"],
  "properties": {
    "schema": {"const": "pythonhk.registry-state/v2"},
    "event_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "phase": {"enum": ["draft", "registration_open", "formation_open", "submissions_open", "frozen", "closed", "archived"]},
    "enabled": {"type": "boolean"},
    "disabled_reason": {"type": "string", "maxLength": 512},
    "lifecycle_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "revision": {"type": "integer", "minimum": 0},
    "users": {"type": "object", "additionalProperties": {"$ref": "#/$defs/user"}},
    "teams": {"type": "object", "additionalProperties": {"$ref": "#/$defs/team"}},
    "memberships": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}},
    "attempts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/attempt"}}
    ,"quotas": {"$ref": "#/$defs/quotas"}
    ,"results": {"type": "object", "additionalProperties": {"$ref": "#/$defs/result"}}
    ,"scoring": {"$ref": "#/$defs/scoring"}
  },
  "$defs": {
    "user": {
      "type": "object", "additionalProperties": false,
      "required": ["github_id", "key_id", "public_key", "proof_digest"],
      "properties": {
        "github_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
        "key_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "public_key": {"type": "string"},
        "proof_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "registration_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "team": {
      "type": "object", "additionalProperties": false,
      "required": ["team_id", "member_ids", "proposal_digest", "activation_commit"],
      "properties": {
        "team_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "member_ids": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"}},
        "proposal_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "activation_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "proof_digests": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["team_id", "github_id", "bundle_sha256", "status", "source_pr"],
      "properties": {
        "team_id": {"type": "string"},
        "github_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
        "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fork_repository_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
        "head_branch": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "status": {"enum": ["reserved", "completed", "rejected", "cancelled"]},
        "source_pr": {"type": "integer", "minimum": 1},
        "source_pr_id": {"type": "string", "pattern": "^[1-9][0-9]{0,31}$"}
      }
    },
    "quotas": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_total_attempts", "maximum_attempts_per_team", "reserved_total", "reserved_by_team"],
      "properties": {
        "maximum_total_attempts": {"type": "integer", "minimum": 0},
        "maximum_attempts_per_team": {"type": "integer", "minimum": 0},
        "reserved_total": {"type": "integer", "minimum": 0},
        "reserved_by_team": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "team_id", "status", "payload_sha256", "scorer_id", "scorer_version", "source_commit"],
      "properties": {
        "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "team_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "status": {"enum": ["accepted", "rejected", "error"]},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scorer_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "scorer_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "scoring": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "isolation", "scorer_id", "scorer_version"],
      "properties": {
        "enabled": {"type": "boolean"},
        "isolation": {"const": "organizer-controlled"},
        "scorer_id": {"type": "string", "maxLength": 64},
        "scorer_version": {"type": "string", "maxLength": 64}
      }
    }
  }
}
