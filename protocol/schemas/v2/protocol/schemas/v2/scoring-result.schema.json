{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pythonhk.org/event/protocol/v2/scoring-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "attempt_id", "team_id", "status", "payload_sha256", "scorer_id", "scorer_version", "source_attempt_digest", "issued_at"],
  "properties": {
    "schema": {"const": "pythonhk.scoring-result/v2"},
    "event_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "team_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "status": {"enum": ["accepted", "rejected", "error"]},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scorer_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "scorer_version": {"type": "string", "pattern": "^[A-Za-z0-9._+-]{1,64}$"},
    "source_attempt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issued_at": {"type": "string", "format": "date-time"}
  }
}
