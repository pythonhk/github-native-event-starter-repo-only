#!/usr/bin/env python3
"""Small deterministic ``gh api`` double used only inside act containers.

The workflows under test use two read-only GitHub API operations: listing PR
files and fetching a blob at a ref. A local black-box test must not use a
developer token or the live GitHub API, so pytest writes the responses below
``GH_MOCK_ROOT`` and puts this executable first on ``PATH`` in the act job.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path
from urllib.parse import parse_qs


def _error(message: str) -> int:
    print(f"fake gh: {message}", file=sys.stderr)
    return 2


def _endpoint(arguments: list[str]) -> str | None:
    return next((argument for argument in arguments if argument.startswith("repos/")), None)


def _jq_expression(arguments: list[str]) -> str | None:
    try:
        return arguments[arguments.index("--jq") + 1]
    except (ValueError, IndexError):
        return None


def _root() -> Path:
    configured = os.environ.get("GH_MOCK_ROOT")
    if not configured:
        raise RuntimeError("GH_MOCK_ROOT is not set")
    return Path(configured)


def _files(root: Path, endpoint: str, arguments: list[str]) -> int:
    try:
        number = endpoint.split("/pulls/", 1)[1].split("/files", 1)[0]
        payload = json.loads((root / "pulls" / f"{number}.json").read_text(encoding="utf-8"))
    except (IndexError, OSError, json.JSONDecodeError) as error:
        return _error(f"cannot load pull-request files: {error}")

    if _jq_expression(arguments) != ".[].filename":
        return _error("only --jq '.[].filename' is supported")
    for item in payload:
        try:
            print(item["filename"])
        except (KeyError, TypeError):
            return _error("pull-request file fixture has no filename")
    return 0


def _content(root: Path, endpoint: str) -> int:
    try:
        resource, query = endpoint.split("?", 1)
        path = resource.split("/contents/", 1)[1]
        ref = parse_qs(query)["ref"][0]
        mapping = json.loads((root / "contents.json").read_text(encoding="utf-8"))
        relative_path = mapping.get(f"{ref}:{path}")
        if relative_path is None:
            candidates = [
                value
                for key, value in mapping.items()
                if key.partition(":")[2] == path
            ]
            if len(candidates) != 1:
                raise KeyError(f"no unique content fixture for {ref}:{path}")
            relative_path = candidates[0]
        content = (root / relative_path).read_bytes()
    except (KeyError, IndexError, OSError, ValueError, json.JSONDecodeError) as error:
        return _error(f"cannot load content fixture: {error}")
    sys.stdout.buffer.write(content)
    return 0


def main(arguments: list[str]) -> int:
    if not arguments or arguments[0] != "api":
        return _error("only 'gh api' is supported")
    endpoint = _endpoint(arguments[1:])
    if endpoint is None:
        return _error("API endpoint is missing")
    try:
        root = _root()
    except RuntimeError as error:
        return _error(str(error))

    if "/pulls/" in endpoint and "/files" in endpoint:
        return _files(root, endpoint, arguments[1:])
    if "/contents/" in endpoint:
        return _content(root, endpoint)
    return _error(f"unsupported endpoint: {endpoint}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
